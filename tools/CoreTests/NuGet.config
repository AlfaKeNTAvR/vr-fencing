<?xml version="1.0" encoding="utf-8"?>
<!-- The user-level NuGet config on the dev laptop lists no package source, so name nuget.org here. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
